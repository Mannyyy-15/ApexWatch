{
  "appId": "com.apexwatch.app",
  "appName": "ApexWatch",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "CapacitorUpdater": {
      "resetWhenUpdate": true,
      "autoUpdate": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#000000"
    }
  },
  "server": {
    "allowNavigation": ["*"]
  }
}
